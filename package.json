{
  "name": "poopsy-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Poopsy Core — minimal, portable core loop for Poopsy-in-a-Box",
  "scripts": {
    "test": "node scripts/test.mjs",
    "sanitize": "./scripts/sanitize_check.sh .",
    "probe:action-ledger": "node scripts/probe_action_ledger.mjs",
    "probe:life-os": "node scripts/probe_life_os_read.mjs",
    "capture:task:dry": "node scripts/capture.mjs --action=task --dry-run --person=james --text=\"TEST TASK\"",
    "capture:processed:dry": "node scripts/capture.mjs --action=processed --dry-run --id=INB-YYYYMMDD-0000",
    "capture:promote:dry": "node scripts/capture.mjs --action=promote --dry-run --id=INB-YYYYMMDD-0000",
    "promote:batch": "node scripts/promote_batch.mjs --max=20"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  }
}
